    <string name="borrar_mascota_mensaje_sin_nombre">Delete this pet? This cannot be undone.</string>

    <!-- Ficha: tarjeta de peso -->
    <string name="ficha_peso_actual">Current weight</string>
    <string name="ficha_sin_datos">No data</string>

    <!-- Ficha: tarjetas de bloque -->
    <string name="ficha_tarjeta_vacunas">Vaccines and preventives</string>
    <string name="ficha_tarjeta_salud">Health and follow-up</string>
    <string name="ficha_tarjeta_notas">Keep in mind</string>
    <string name="ficha_tarjeta_notas_detalle">Important information about the pet</string>

    <!-- Estados de las dosis, usados en las pastillas de la ficha.
         OJO: sin "%d" dentro. `pluralStringResource` elige la forma por la cantidad pero NO
         sustituye argumentos (comprobado), así que el número se compone aparte en el código. -->
    <plurals name="ficha_vencidas">
        <item quantity="one">overdue</item>
        <item quantity="other">overdue</item>
    </plurals>
    <plurals name="ficha_proximas">
        <item quantity="one">due soon</item>
        <item quantity="other">due soon</item>
    </plurals>
    <plurals name="ficha_activos">
        <item quantity="one">active</item>
        <item quantity="other">active</item>
    </plurals>

    <!-- Ficha: opciones de foto -->
    <string name="foto_titulo">%1$s\'s photo</string>
    <string name="foto_hacer">Take a photo</string>
    <string name="foto_elegir">Choose from my files</string>
    <string name="foto_quitar">Remove photo</string>

    <!-- Ficha: menú de acciones -->
    <string name="ficha_modificar_datos">Edit details</string>

    <!-- Diálogo de exportar a PDF -->
    <string name="exportar_titulo">Export pet record as PDF</string>
    <string name="exportar_elegir_version">Choose which version to export:</string>
