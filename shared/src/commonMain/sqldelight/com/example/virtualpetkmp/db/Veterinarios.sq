-- `uuid` y `actualizadoEn`: ver la explicación en Mascotas.sq. Los veterinarios también los
-- llevan aunque no cuelguen de una mascota: son globales, y al importar hay que reconocerlos para
-- no acabar con la misma clínica repetida en cada importación.
CREATE TABLE veterinarios (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nombreClinica TEXT NOT NULL,
    nombreVeterinario TEXT,
    telefono TEXT NOT NULL,
    direccion TEXT NOT NULL,
    esUrgencias INTEGER NOT NULL DEFAULT 0,
    uuid TEXT NOT NULL,
    actualizadoEn INTEGER NOT NULL
);

-- Búsqueda por identificador universal, que es la que hace la fusión al importar.
CREATE INDEX idx_veterinarios_uuid ON veterinarios(uuid);


selectAll:
SELECT * FROM veterinarios ORDER BY esUrgencias DESC, nombreClinica ASC;

selectById:
SELECT * FROM veterinarios WHERE id = ?;

selectUrgencias:
SELECT * FROM veterinarios WHERE esUrgencias = 1;

insert:
INSERT INTO veterinarios(nombreClinica, nombreVeterinario, telefono, direccion, esUrgencias, uuid, actualizadoEn)
VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE veterinarios
SET nombreClinica = ?, nombreVeterinario = ?, telefono = ?, direccion = ?, esUrgencias = ?, actualizadoEn = ?
WHERE id = ?;

delete:
DELETE FROM veterinarios WHERE id = ?;

getLastInsertedId:
SELECT last_insert_rowid() AS id;


-- Vaciar la tabla. Solo lo usa la restauración de una copia, que reemplaza el contenido entero
-- dentro de una transacción; en el uso normal nada borra filas por esta consulta.
deleteAll:
DELETE FROM veterinarios;
