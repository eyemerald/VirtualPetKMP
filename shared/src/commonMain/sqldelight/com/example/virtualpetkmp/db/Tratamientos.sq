-- `uuid` y `actualizadoEn`: ver la explicación en Mascotas.sq.
CREATE TABLE tratamientos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mascotaId INTEGER NOT NULL,
    nombreMedicamento TEXT NOT NULL,
    dosis TEXT,
    frecuencia TEXT,
    fechaInicio TEXT NOT NULL,
    fechaFin TEXT,
    -- Hora del aviso, en formato "HH:mm". NULL = sin hora.
    hora TEXT,
    -- 0/1: 1 = el usuario quiere que se le avise a esa hora mientras dure el tratamiento.
    -- SQLite no tiene booleanos: se guarda como entero y el repositorio lo convierte.
    notificar INTEGER NOT NULL DEFAULT 0,
    uuid TEXT NOT NULL,
    actualizadoEn INTEGER NOT NULL,
    -- Veces al dia (1..6) y las horas de cada toma ("08:00,14:00,22:00"). NULL en los tratamientos
    -- anteriores a la 1.14: esos se comportan como una sola toma a la hora de `hora`.
    -- Van al final a proposito: `ALTER TABLE ... ADD COLUMN` (migracion 16) las deja ahi, y una
    -- instalacion nueva tiene que quedar identica a una base migrada.
    vecesAlDia INTEGER,
    horas TEXT,
    FOREIGN KEY (mascotaId) REFERENCES mascotas(id) ON DELETE CASCADE
);

-- Búsqueda por identificador universal, que es la que hace la fusión al importar.
CREATE INDEX idx_tratamientos_uuid ON tratamientos(uuid);


selectByMascotaId:
SELECT * FROM tratamientos WHERE mascotaId = ? ORDER BY fechaInicio DESC;

-- Tratamientos de todas las mascotas que piden aviso, con el nombre de su mascota.
-- Es lo que necesita el receptor de arranque del móvil para volver a programar las alarmas
-- que Android borra al apagar el dispositivo.
selectConRecordatorio:
SELECT tratamientos.*, mascotas.nombre AS nombreMascota
FROM tratamientos
JOIN mascotas ON mascotas.id = tratamientos.mascotaId
WHERE tratamientos.notificar = 1;

insert:
INSERT INTO tratamientos(mascotaId, nombreMedicamento, dosis, frecuencia, fechaInicio, fechaFin, hora, notificar, vecesAlDia, horas, uuid, actualizadoEn)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE tratamientos 
SET nombreMedicamento = ?, dosis = ?, frecuencia = ?, fechaInicio = ?, fechaFin = ?, hora = ?, notificar = ?, vecesAlDia = ?, horas = ?, actualizadoEn = ?
WHERE id = ?;

delete:
DELETE FROM tratamientos WHERE id = ?;


-- Todas las filas, para la copia de seguridad (la exportación no va mascota a mascota).
selectAll:
SELECT * FROM tratamientos;


-- Vaciar la tabla. Solo lo usa la restauración de una copia, que reemplaza el contenido entero
-- dentro de una transacción; en el uso normal nada borra filas por esta consulta.
deleteAll:
DELETE FROM tratamientos;
