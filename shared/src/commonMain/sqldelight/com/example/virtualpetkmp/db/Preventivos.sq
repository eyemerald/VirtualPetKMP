-- `uuid` y `actualizadoEn`: ver la explicación en Mascotas.sq.
CREATE TABLE preventivos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mascotaId INTEGER NOT NULL,
    tipo TEXT NOT NULL,
    nombre TEXT NOT NULL,
    fechaAplicacion TEXT NOT NULL,
    fechaProximaDosis TEXT NOT NULL,
    veterinario TEXT,
    lote TEXT,
    uuid TEXT NOT NULL,
    actualizadoEn INTEGER NOT NULL,
    FOREIGN KEY (mascotaId) REFERENCES mascotas(id) ON DELETE CASCADE
);

-- Búsqueda por identificador universal, que es la que hace la fusión al importar.
CREATE INDEX idx_preventivos_uuid ON preventivos(uuid);


selectByMascotaId:
SELECT * FROM preventivos WHERE mascotaId = ? ORDER BY fechaAplicacion DESC;

selectByMascotaIdAndTipo:
SELECT * FROM preventivos WHERE mascotaId = ? AND tipo = ? ORDER BY fechaAplicacion DESC;

insert:
INSERT INTO preventivos(mascotaId, tipo, nombre, fechaAplicacion, fechaProximaDosis, veterinario, lote, uuid, actualizadoEn)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE preventivos
SET tipo = ?, nombre = ?, fechaAplicacion = ?, fechaProximaDosis = ?, veterinario = ?, lote = ?, actualizadoEn = ?
WHERE id = ?;

delete:
DELETE FROM preventivos WHERE id = ?;

getLastInsertedId:
SELECT last_insert_rowid() AS id;

selectAll:
SELECT * FROM preventivos ORDER BY fechaAplicacion DESC;


-- Vaciar la tabla. Solo lo usa la restauración de una copia, que reemplaza el contenido entero
-- dentro de una transacción; en el uso normal nada borra filas por esta consulta.
deleteAll:
DELETE FROM preventivos;
