-- Identificador universal de cada fila: no cambia nunca y no depende del id local. Es lo que
-- permitirá reconocer la misma mascota en otro dispositivo al exportar e importar (ver
-- docs/TRASPASO_DE_DATOS.md). 32 caracteres hexadecimales en minúscula, sin guiones, que es el
-- mismo formato que escribe la migración 13 con `randomblob`.
--
-- `actualizadoEn` son milisegundos desde epoch de la última modificación: sirve para decidir qué
-- versión de un registro es la más nueva cuando la misma mascota existe en dos dispositivos.
CREATE TABLE mascotas (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre TEXT NOT NULL,
    especie TEXT NOT NULL,
    raza TEXT NOT NULL,
    fechaNacimiento TEXT NOT NULL,
    sexo TEXT NOT NULL,
    color TEXT NOT NULL,
    microchip TEXT,
    foto TEXT,
    -- Peso ideal en kilos, opcional: null = el usuario no lo ha configurado.
    peso_ideal REAL,
    uuid TEXT NOT NULL,
    actualizadoEn INTEGER NOT NULL
);

-- Búsqueda por identificador universal, que es la que hace la fusión al importar.
CREATE INDEX idx_mascotas_uuid ON mascotas(uuid);


selectAll:
SELECT * FROM mascotas;

selectById:
SELECT * FROM mascotas WHERE id = ?;

checkNombreUnico:
SELECT id FROM mascotas WHERE LOWER(nombre) = LOWER(?);

insert:
INSERT INTO mascotas(nombre, especie, raza, fechaNacimiento, sexo, color, microchip, foto, peso_ideal, uuid, actualizadoEn)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE mascotas
SET nombre = ?, especie = ?, raza = ?, fechaNacimiento = ?, sexo = ?, color = ?, microchip = ?, foto = ?, peso_ideal = ?, actualizadoEn = ?
WHERE id = ?;

updateFoto:
UPDATE mascotas SET foto = ?, actualizadoEn = ? WHERE id = ?;

updatePesoIdeal:
UPDATE mascotas SET peso_ideal = ?, actualizadoEn = ? WHERE id = ?;

delete:
DELETE FROM mascotas WHERE id = ?;

getLastInsertedId:
SELECT last_insert_rowid() AS id;


-- Vaciar la tabla. Solo lo usa la restauración de una copia, que reemplaza el contenido entero
-- dentro de una transacción; en el uso normal nada borra filas por esta consulta.
deleteAll:
DELETE FROM mascotas;
