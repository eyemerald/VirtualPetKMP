-- `uuid` y `actualizadoEn`: ver la explicación en Mascotas.sq.
CREATE TABLE revisiones (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mascotaId INTEGER NOT NULL,
    fecha TEXT NOT NULL,
    motivo TEXT NOT NULL,
    diagnostico TEXT,
    notas TEXT,
    veterinario TEXT,
    uuid TEXT NOT NULL,
    actualizadoEn INTEGER NOT NULL,
    FOREIGN KEY (mascotaId) REFERENCES mascotas(id) ON DELETE CASCADE
);

-- Búsqueda por identificador universal, que es la que hace la fusión al importar.
CREATE INDEX idx_revisiones_uuid ON revisiones(uuid);


selectByMascotaId:
SELECT * FROM revisiones WHERE mascotaId = ? ORDER BY fecha DESC;

insert:
INSERT INTO revisiones(mascotaId, fecha, motivo, diagnostico, notas, veterinario, uuid, actualizadoEn)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE revisiones 
SET fecha = ?, motivo = ?, diagnostico = ?, notas = ?, veterinario = ?, actualizadoEn = ?
WHERE id = ?;

delete:
DELETE FROM revisiones WHERE id = ?;


-- Todas las filas, para la copia de seguridad (la exportación no va mascota a mascota).
selectAll:
SELECT * FROM revisiones;


-- Vaciar la tabla. Solo lo usa la restauración de una copia, que reemplaza el contenido entero
-- dentro de una transacción; en el uso normal nada borra filas por esta consulta.
deleteAll:
DELETE FROM revisiones;
