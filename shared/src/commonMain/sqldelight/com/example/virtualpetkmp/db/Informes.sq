CREATE TABLE informes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mascotaId INTEGER NOT NULL,
    tipo TEXT NOT NULL,
    descripcion TEXT,
    fecha TEXT NOT NULL,
    nombreArchivo TEXT NOT NULL,
    rutaArchivo TEXT NOT NULL,
    FOREIGN KEY (mascotaId) REFERENCES mascotas(id) ON DELETE CASCADE
);

selectByMascotaId:
SELECT * FROM informes WHERE mascotaId = ? ORDER BY fecha DESC;

insert:
INSERT INTO informes(mascotaId, tipo, descripcion, fecha, nombreArchivo, rutaArchivo)
VALUES (?, ?, ?, ?, ?, ?);

update:
UPDATE informes 
SET tipo = ?, descripcion = ?, fecha = ?
WHERE id = ?;

delete:
DELETE FROM informes WHERE id = ?;
