-- `uuid` y `actualizadoEn`: ver la explicación en Mascotas.sq.
CREATE TABLE informes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mascotaId INTEGER NOT NULL,
    tipo TEXT NOT NULL,
    descripcion TEXT,
    fecha TEXT NOT NULL,
    nombreArchivo TEXT NOT NULL,
    rutaArchivo TEXT NOT NULL,
    uuid TEXT NOT NULL,
    actualizadoEn INTEGER NOT NULL,
    FOREIGN KEY (mascotaId) REFERENCES mascotas(id) ON DELETE CASCADE
);

-- Búsqueda por identificador universal, que es la que hace la fusión al importar.
CREATE INDEX idx_informes_uuid ON informes(uuid);


selectByMascotaId:
SELECT * FROM informes WHERE mascotaId = ? ORDER BY fecha DESC;

insert:
INSERT INTO informes(mascotaId, tipo, descripcion, fecha, nombreArchivo, rutaArchivo, uuid, actualizadoEn)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE informes 
SET tipo = ?, descripcion = ?, fecha = ?, actualizadoEn = ?
WHERE id = ?;

delete:
DELETE FROM informes WHERE id = ?;

-- Reapunta un informe a otro archivo. Solo lo usa la fusión: si el documento no estaba en este
-- dispositivo pero el paquete lo trae, se extrae y hay que volver a apuntar la fila a la copia
-- local. Va aparte de `update` para que una edición normal no toque la ruta.
updateArchivo:
UPDATE informes SET rutaArchivo = ? WHERE id = ?;


-- Todas las filas, para la copia de seguridad (la exportación no va mascota a mascota).
selectAll:
SELECT * FROM informes;


-- Vaciar la tabla. Solo lo usa la restauración de una copia, que reemplaza el contenido entero
-- dentro de una transacción; en el uso normal nada borra filas por esta consulta.
deleteAll:
DELETE FROM informes;
