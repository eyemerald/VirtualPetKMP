-- `uuid` y `actualizadoEn`: ver la explicación en Mascotas.sq.
CREATE TABLE pesos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mascotaId INTEGER NOT NULL,
    fecha TEXT NOT NULL,
    peso REAL NOT NULL,
    notas TEXT,
    uuid TEXT NOT NULL,
    actualizadoEn INTEGER NOT NULL,
    FOREIGN KEY (mascotaId) REFERENCES mascotas(id) ON DELETE CASCADE
);

-- Búsqueda por identificador universal, que es la que hace la fusión al importar.
CREATE INDEX idx_pesos_uuid ON pesos(uuid);


selectByMascotaId:
SELECT * FROM pesos WHERE mascotaId = ? ORDER BY fecha ASC;

-- Último peso de cada mascota, para el indicador de la lista (▲/▼ frente al peso ideal).
ultimoPesoDeCadaMascota:
SELECT mascotaId, peso, MAX(fecha) AS fecha
FROM pesos
GROUP BY mascotaId;

insert:
INSERT INTO pesos(mascotaId, fecha, peso, notas, uuid, actualizadoEn) VALUES (?, ?, ?, ?, ?, ?);

update:
UPDATE pesos SET fecha = ?, peso = ?, notas = ?, actualizadoEn = ? WHERE id = ?;

delete:
DELETE FROM pesos WHERE id = ?;


-- Todas las filas, para la copia de seguridad (la exportación no va mascota a mascota).
selectAll:
SELECT * FROM pesos;


-- Vaciar la tabla. Solo lo usa la restauración de una copia, que reemplaza el contenido entero
-- dentro de una transacción; en el uso normal nada borra filas por esta consulta.
deleteAll:
DELETE FROM pesos;
