-- `uuid` y `actualizadoEn`: ver la explicación en Mascotas.sq. Todas las tablas las llevan para que
-- exportar e importar pueda reconocer cada fila en otro dispositivo sin depender del id local.
CREATE TABLE vacunas (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mascotaId INTEGER NOT NULL,
    nombre TEXT NOT NULL,
    fechaAplicacion TEXT NOT NULL,
    fechaProximaDosis TEXT NOT NULL,
    veterinario TEXT,
    lote TEXT,
    uuid TEXT NOT NULL,
    actualizadoEn INTEGER NOT NULL,
    FOREIGN KEY (mascotaId) REFERENCES mascotas(id) ON DELETE CASCADE
);

-- Búsqueda por identificador universal, que es la que hace la fusión al importar.
CREATE INDEX idx_vacunas_uuid ON vacunas(uuid);
-- Indice para los filtros de pendientes de la lista de mascotas: la consulta busca por
-- mascota y agrupa por nombre, que es justo este par de columnas.
CREATE INDEX idx_vacunas_mascota_nombre ON vacunas(mascotaId, nombre);



selectByMascotaId:
SELECT * FROM vacunas WHERE mascotaId = ? ORDER BY fechaAplicacion DESC;

insert:
INSERT INTO vacunas(mascotaId, nombre, fechaAplicacion, fechaProximaDosis, veterinario, lote, uuid, actualizadoEn)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE vacunas 
SET nombre = ?, fechaAplicacion = ?, fechaProximaDosis = ?, veterinario = ?, lote = ?, actualizadoEn = ?
WHERE id = ?;

delete:
DELETE FROM vacunas WHERE id = ?;

getLastInsertedId:
SELECT last_insert_rowid() AS id;

selectAll:
SELECT * FROM vacunas ORDER BY fechaAplicacion DESC;

-- Una vacuna por su identificador universal: es lo que usa su aviso al sonar, porque el id local
-- cambia al restaurar una copia.
selectByUuid:
SELECT * FROM vacunas WHERE uuid = ?;


-- Vaciar la tabla. Solo lo usa la restauración de una copia, que reemplaza el contenido entero
-- dentro de una transacción; en el uso normal nada borra filas por esta consulta.
deleteAll:
DELETE FROM vacunas;
