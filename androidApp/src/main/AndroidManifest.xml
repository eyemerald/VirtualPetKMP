<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Android borra las alarmas al apagar el móvil: este permiso es para volver a programar
         los recordatorios de tratamiento cuando el dispositivo arranca. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!--
      La biblioteca compartida arrastra tres permisos heredados que esta app no usa: los archivos
      se eligen con el selector del sistema (SAF) y las fotos se copian a la carpeta privada, así
      que no hace falta tocar el almacenamiento ni el teléfono. Se quitan aquí para que quien
      instale la APK no vea "leer el estado del teléfono" y se asuste.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove"/>

    <application
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!--
          `singleTop`: tocar el aviso de un tratamiento con la app ya abierta NO debe crear una
          segunda pantalla encima de la actual; el aviso llega a `onNewIntent` y la app navega
          desde donde esté.
        -->
        <activity
                android:exported="true"
                android:launchMode="singleTop"
                android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths"/>
        </provider>

        <receiver
            android:name=".NotificacionReceiver"
            android:exported="false"/>

        <!--
          Los dos botones del aviso de tratamiento (Aceptar / Posponer). Las acciones las manda la
          propia notificación, desde la misma app: `exported="false"` para que ninguna otra pueda
          dar por buena una dosis ajena.
        -->
        <receiver
            android:name=".AccionRecordatorioReceiver"
            android:exported="false"/>

        <!--
          Reprograma los recordatorios de tratamiento al arrancar el móvil (Android borra las
          alarmas al apagar) y al actualizar la app. `exported="false"` porque solo lo manda el
          sistema, y BOOT_COMPLETED es un broadcast protegido: ninguna app puede falsificarlo.
        -->
        <receiver
            android:name=".ReinicioReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
    </application>

</manifest>
